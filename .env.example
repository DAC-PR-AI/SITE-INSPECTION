# ─────────────────────────────────────────────────────────────────────────────
# DAC INSPECTION APP — PRODUCTION ENVIRONMENT VARIABLES (Vercel)
# ─────────────────────────────────────────────────────────────────────────────
# Add these in Vercel Dashboard: Project Settings → Environment Variables
# Applied to: Production, Preview, Development

# ── 1. Google Cloud Service Account Credentials (REQUIRED) ───────────────────
# Email of the Google Cloud Service Account with Google Sheets & Drive API enabled
GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com

# Private Key from the Service Account JSON key file (include BEGIN/END and \n escapes)
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQD_YOUR_FAKE_KEY_HERE_==\n-----END PRIVATE KEY-----\n"

# ── 2. Google Spreadsheets & Drive IDs (REQUIRED) ───────────────────────────
# Primary Google Spreadsheet ID (Inspections, Projects, ApprovalHistory, Signatures, Users)
GOOGLE_SHEET_ID=YOUR_PRIMARY_SPREADSHEET_ID

# Secondary Google Spreadsheet ID for Photo Logs & Handover Photos
GOOGLE_PHOTO_SHEET_ID=YOUR_PHOTO_LOGS_SPREADSHEET_ID

# Optional: Google Drive Root Folder ID for photo storage (fallback to inline Base64 storage)
GOOGLE_DRIVE_FOLDER_ID=YOUR_DRIVE_ROOT_FOLDER_ID

# ── 3. Session Cryptographic Signing Secret (RECOMMENDED) ────────────────────
# A 32+ character random secret used for HMAC-SHA256 session cookie signing
# Generate with: openssl rand -base64 32
SESSION_SECRET=YOUR_32_CHAR_RANDOM_SESSION_SIGNING_SECRET

# ── 4. Fallback Role PINs (Optional — Primary auth uses Column G Passwords) ──
AUTH_PIN_START_INSPECTION=replace-with-6-digit-pin
AUTH_PIN_SITE_ENGINEER=replace-with-6-digit-pin
AUTH_PIN_CUSTOMER=replace-with-6-digit-pin
AUTH_PIN_TECHNICAL_EXECUTIVE=replace-with-6-digit-pin
AUTH_PIN_QAQC=replace-with-6-digit-pin
AUTH_PIN_PROJECT_MANAGER=replace-with-6-digit-pin
AUTH_PIN_MANAGER_TECHNICAL=replace-with-6-digit-pin
AUTH_PIN_GM_HUG=replace-with-6-digit-pin
AUTH_PIN_VP_HUG=replace-with-6-digit-pin
AUTH_PIN_ADMIN=replace-with-6-digit-pin

# ── 5. Upstash Redis REST API for Serverless Rate Limiting (Optional) ────────
# UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

