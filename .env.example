# Google Cloud service account used to read/write the Google Sheet.
# See README.md for how to create these.

GOOGLE_SHEETS_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Paste the private key from the service account JSON key file.
# Keep the quotes and the literal \n newline markers.
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_CONTENT\n-----END PRIVATE KEY-----\n"

# The ID from your Google Sheet's URL:
# https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
GOOGLE_SHEET_ID=your-google-sheet-id

# ─────────────────────────────────────────────────────────────────────────────
# 6-Digit Role Authentication PINs (REQUIRED — set all in Vercel dashboard)
# ─────────────────────────────────────────────────────────────────────────────
AUTH_PIN_START_INSPECTION=272727
AUTH_PIN_SITE_ENGINEER=272727
AUTH_PIN_CUSTOMER=111111
AUTH_PIN_QAQC=202020
AUTH_PIN_PROJECT_MANAGER=303030
AUTH_PIN_TECHNICAL_EXECUTIVE=444444
AUTH_PIN_MANAGER_TECHNICAL=454545
AUTH_PIN_GM_HUG=404040
AUTH_PIN_VP_HUG=505050
AUTH_PIN_ADMIN=999999

